# Server-side only. Read by the Vite dev server, never shipped to the browser.
ANTHROPIC_API_KEY=
# Optional: low | medium | high. Low keeps the counter fast.
MENU_EFFORT=low
# Optional: where to read Magic's private rewrite prompt from (never copied into this repo).
MAGIC_REPO=~/Github/lexi-magic
MAGIC_REF=origin/main
